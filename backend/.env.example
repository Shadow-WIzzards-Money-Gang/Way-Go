# Porta do servidor HTTP (Spring Boot)
PORT=8080

CORS_ORIGENS_PERMITIDAS=*

# Banco de dados Oracle (Thin Driver)
DB_HOST=localhost
DB_PORT=1521
DB_NAME=FREEPDB1
DB_USERNAME=app
DB_PASSWORD=app123

# Integração com a API Trilhos Agora
# URL base da API
TRILHOS_AGORA_URL=https://api.trilhosagora.com.br/v1

# Chave de acesso à API
TRILHOS_AGORA_API_KEY=

# Intervalo entre as consultas, no formato ISO-8601 (PT2M = 2 minutos, PT30S = 30 segundos)
TRILHOS_AGORA_INTERVALO=PT2M

# Liga/desliga o agendamento de atualização dos status (true/false)
TRILHOS_AGORA_AGENDAMENTO=true

# De quanto em quanto tempo o cache de status em memória é recarregado do banco (ISO-8601)
TRILHOS_AGORA_RECARGA_CACHE=PT30M

# Cálculo de rotas
# Critério usado quando a requisição não informa um (MENOR_TEMPO, MENOS_BALDEACOES, EQUILIBRADO)
ROTAS_CRITERIO_PADRAO=EQUILIBRADO

# Custo extra por baldeação no critério EQUILIBRADO, só para escolher a rota (ISO-8601)
ROTAS_PENALIDADE_BALDEACAO=PT3M

# Multiplicador do tempo de viagem em linhas com velocidade reduzida ou operação parcial
ROTAS_FATOR_LENTIDAO=1.5

# De quanto em quanto tempo o grafo da rede em memória é remontado a partir do banco (ISO-8601)
ROTAS_RECARGA_GRAFO=PT6H

# Autenticacao JWT
JWT_SEGREDO=segredo

# Validade do token
JWT_EXPIRACAO_MINUTOS=60

# Emissor do token
JWT_EMISSOR=way-go
