# Copie para .env e ajuste. Só variáveis com prefixo EXPO_PUBLIC_ chegam ao app
# (elas ficam visíveis no bundle: nunca coloque segredos aqui).

# Protocolo da API (http ou https)
EXPO_PUBLIC_API_PROTOCOL=http

# Host da API. Deixe vazio para usar automaticamente o IP da máquina que roda o Metro
# (funciona no Expo Go em celular físico). No emulador Android, "localhost" não funciona:
# use 10.0.2.2 ou deixe vazio.
EXPO_PUBLIC_API_HOST=

# Porta da API (mesma variável PORT do backend)
EXPO_PUBLIC_API_PORT=8080

# Prefixo das rotas da API (WebConfig.API_PREFIXO no backend)
EXPO_PUBLIC_API_PREFIX=/api/v1

# Tempo máximo de espera de cada requisição, em milissegundos
EXPO_PUBLIC_API_TIMEOUT_MS=10000

# Intervalo de atualização automática do status das linhas, em milissegundos
EXPO_PUBLIC_STATUS_REFRESH_MS=120000
