# Copie para .env (na raiz do projeto) antes de rodar o docker compose.

# IP da sua máquina na rede local (Windows: ipconfig, "Endereço IPv4"; Linux/macOS: ip addr / ifconfig).
# O celular com Expo Go usa esse IP para baixar o app e falar com o backend.
# Sem ele, só o navegador (http://localhost:8081) e o emulador funcionam.
HOST_IP=192.168.0.10
